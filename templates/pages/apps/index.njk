{% extends "layout.njk" %}
{% set pageTitle = "Khopa | Apps" %}
{% set description = "Apps." %}
{% set bodyClass = "page-main" %}

{% block mainContent %}
<div class="container">
  <section class="page-hero" data-reveal>
    <p class="eyebrow">Apps</p>
    <h1>Apps.</h1>
    <p>Online apps</p>
  </section>

  <section class="card-grid card-grid--apps">
    <article class="app-card" data-reveal>
      <h3>Les Petites Lettres</h3>
      <p>"Les Petites Lettres" helps parents and teachers create printable handwriting worksheets for preschool and
        kindergarten children.</p>
      <p>Select letters, numbers, or words, generate a printable PDF in seconds.</p>
      <p>Simple, Fast, No-BS free SaaS.</p>
      <a href="./lespetiteslettres/index.html">Open app</a>
    </article>

    <article class="app-card" data-reveal>
      <h3>MotMot Advance</h3>
      <p>A word-guessing game for the Game Boy Advance: find the 5-letter word in six tries. Classic, Marathon
        and Time Attack modes, five languages, chiptune sound.</p>
      <p>Playable in the browser (EmulatorJS), or download the ROM for a real GBA.</p>
      <a href="./motmot/index.html">Play in the browser</a>
    </article>
  </section>
</div>
{% endblock %}
