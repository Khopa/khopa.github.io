{% extends "layout.njk" %}
{% set pageTitle = "Khopa | Apps" %}
{% set description = "Apps." %}
{% set bodyClass = "page-main" %}

{% block mainContent %}
<div class="container">
  <section class="page-hero" data-reveal>
    <p class="eyebrow">Apps</p>
    <h1>Apps.</h1>
    <p>Online apps</p>
  </section>

    <section class="card-grid card-grid--apps">
      <article class="project-card" data-reveal>
        <a class="project-card__visual" href="./lespetiteslettres/index.html">
          <img src="../assets/images/apps/lespetiteslettres.png" alt="Les Petites Lettres">
        </a>
        <div class="project-card__body">
          <p class="card-kicker">Web app</p>
          <h3><a href="./lespetiteslettres/index.html">Les Petites Lettres</a></h3>
          <p>"Les Petites Lettres" helps parents and teachers create printable handwriting worksheets for preschool
            and kindergarten children. Select letters, numbers, or words, generate a printable PDF in seconds.
            Simple, fast, no-BS free SaaS.</p>
          <ul class="tag-row">
            <li>Education</li>
            <li>PDF</li>
            <li>Free</li>
          </ul>
          <div class="card-actions">
            <a href="./lespetiteslettres/index.html">Open app</a>
          </div>
        </div>
      </article>

      <article class="project-card" data-reveal>
        <a class="project-card__visual" href="./motmot/index.html">
          <img src="../assets/images/apps/motmot.png" alt="MotMot Advance">
        </a>
        <div class="project-card__body">
          <p class="card-kicker">Game Boy Advance game</p>
          <h3><a href="./motmot/index.html">MotMot Advance</a></h3>
          <p>A word-guessing game for the Game Boy Advance: find the 5-letter word in six tries. Classic, Marathon
            and Time Attack modes, five languages. Playable in the browser, or download the ROM for a real GBA.</p>
          <ul class="tag-row">
            <li>GBA</li>
            <li>Homebrew</li>
            <li>Game Dev</li>
          </ul>
          <div class="card-actions">
            <a href="./motmot/index.html">Play in the browser</a>
            <a href="https://github.com/Khopa/motmot-advance">Source code</a>
          </div>
        </div>
      </article>
    </section>
</div>
{% endblock %}
